  "toolProfiles": [
    "workspace-simulator"
  ],
  "simulator": {
    "entryPoint": "private/stockroom.py",
    "executable": "python3",
    "description": "The stockroom simulator (see public/RULES.md). command: \"observe\" | \"order\" | \"advance\" | \"result\"; for \"order\", arguments {\"product\": name, \"supplier\": \"local\" | \"import\", \"quantity\": integer, \"ref\": unique string}. Returns a JSON reply. \"advance\" ends the current day.",
    "timeoutMs": 30000
  },
  "grader": {
    "id": "ap-stockroom-replay",
    "version": "1.0.0",
    "entryPoint": "private/grader.py",
    "executable": "python3",
    "args": [
      "{entryPoint}",
      "--request",
      "{request}",
      "--result",
      "{result}"
    ]
  },
  "environment": {
    "runtime": "Python 3.13",
    "dependencies": "Python standard library; no network",
    "network": false,
    "runtimeCheck": {
      "executable": "python3",
      "args": [
        "--version"
      ],
      "expectedSubstring": "Python 3.13."
    }
  }
}
